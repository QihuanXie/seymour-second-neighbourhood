title: "A short combinatorial proof of Seymour's second-neighbourhood conjecture"
authors:
  - family-names: Xie
    given-names: Qihuan
    affiliation: University of British Columbia
    email: qhxie@student.ubc.ca
version: 1.0.0
date-released: 2026-10-31
